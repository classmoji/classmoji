{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "tasks": {
    "lint": {
      "outputs": [],
      "cache": true
    },
    "lint:fix": {
      "outputs": [],
      "cache": false
    },
    "format": {
      "outputs": [],
      "cache": false
    },
    "format:check": {
      "outputs": [],
      "cache": true
    },
    "build": {
      "outputs": []
    },
    "web:build": {},
    "web:dev": {
      "persistent": true,
      "cache": false
    },
    "web:start": {
      "dependsOn": ["^db:generate"]
    },
    "trigger:deploy": {},
    "trigger:deploy:staging": {},
    "trigger:dev": {
      "persistent": true,
      "cache": false
    },
    "hook:stripe": {
      "persistent": true,
      "cache": false
    },
    "hook:github": {
      "persistent": true,
      "cache": false
    },
    "hook:dev": {
      "persistent": true,
      "cache": false
    },
    "hook:start": {
      "dependsOn": ["^db:generate"]
    },
    "mcp:dev": {
      "persistent": true,
      "cache": false
    },
    "mcp:start": {
      "dependsOn": ["^db:generate"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "start": {
      "dependsOn": ["^db:generate"]
    },
    "slides:dev": {
      "persistent": true,
      "cache": false
    },
    "slides:build": {},
    "slides:start": {
      "dependsOn": ["^db:generate"]
    },
    "pages:dev": {
      "persistent": true,
      "cache": false
    },
    "pages:build": {},
    "pages:start": {
      "dependsOn": ["^db:generate"]
    },
    "admin:dev": {
      "persistent": true,
      "cache": false
    },
    "admin:build": {},
    "admin:start": {
      "dependsOn": ["^db:generate"]
    },
    "db:generate": {},
    "db:start": {},
    "db:deploy": {
      "cache": false
    },
    "db:seed": {},
    "db:reset": {},
    "db:reset:noseed": {},
    "db:dev": {},
    "test": {
      "cache": false,
      // The webapp is the one workspace whose `test` script is Playwright rather
      // than vitest (every other workspace's `test` IS its unit suite), so its
      // vitest suites — including the Ask Moji auth/authz tests under
      // app/routes/**/__tests__ — had no aggregate that reached them and ran only
      // when someone remembered. This makes the root `npm run test` run them
      // first: turbo resolves an unprefixed dependency within the SAME package,
      // and simply skips it for the workspaces that define no such script.
      "dependsOn": ["web:test:unit"],
      // turbo hands a task only the environment it has been told about, so an
      // E2E_* variable set on the command line simply does not reach Playwright
      // unless it is named here. The failure mode is quiet and expensive: the
      // content-delivery pack reads these to decide what it can exercise, so a
      // missing name turns into every scenario skipping and a green run that
      // tested nothing. Declared on the task rather than in globalEnv because
      // these steer tests only — they are not part of any build's identity.
      "env": [
        "E2E_TARGET",
        "E2E_PAGES_URL",
        "E2E_SLIDES_URL",
        "E2E_WEBAPP_URL",
        "E2E_CLASS_SITE_URL",
        "E2E_CLASSROOM_SLUG",
        "E2E_CD_CONTENT_REPO",
        "E2E_SESSION_COOKIE",
        "E2E_ALLOW_REMOTE_DB_I_KNOW_WHAT_I_AM_DOING",
        "TEST_CLASSROOM_SLUG"
      ],
      "outputs": ["test-results/**", "playwright-report/**"]
    },
    "test:integration": {
      "cache": false,
      "outputs": []
    },
    "web:test": {
      "cache": false,
      "outputs": ["test-results/**", "playwright-report/**"]
    },
    "web:test:ui": {
      "cache": false,
      "persistent": true
    },
    // Webapp vitest (apps/webapp `web:test:unit`). Uncached like the sibling test
    // tasks, and with no outputs: vitest writes no artifact to restore, unlike
    // Playwright's test-results/ and playwright-report/.
    "web:test:unit": {
      "cache": false,
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  },
  "globalEnv": [
    "BETTER_AUTH_SECRET",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "GITHUB_APP_ID",
