  classroom Classroom @relation(fields: [classroom_id], references: [id], onDelete: Cascade)

  @@unique([resource_path, user_id, classroom_id])
  @@index([classroom_id, resource_path])
  @@index([last_viewed_at])
  @@map("resource_views")
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

model Notification {
  id            String           @id @default(uuid())
  user_id       String
  classroom_id  String?
  type          NotificationType
  resource_type String
  resource_id   String
  title         String
  metadata      Json?
  read_at       DateTime?
  expires_at    DateTime
  created_at    DateTime         @default(now())

  user      User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  classroom Classroom? @relation(fields: [classroom_id], references: [id], onDelete: Cascade)

  @@index([user_id, read_at, created_at])
  @@index([expires_at])
  @@map("notifications")
}

model NotificationPreference {
  user_id                           String   @id
  email_quiz_published              Boolean  @default(true)
  email_page_published              Boolean  @default(false)
  email_page_unpublished            Boolean  @default(false)
  email_repository_published        Boolean  @default(true)
  email_repository_unpublished      Boolean  @default(false)
  email_assignment_due_date_changed Boolean  @default(true)
  email_assignment_graded           Boolean  @default(true)
  email_ta_grading_assigned         Boolean  @default(true)
  email_ta_regrade_assigned         Boolean  @default(true)
  created_at                        DateTime @default(now())
  updated_at                        DateTime @default(now()) @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model ProcessedWebhookEvent {
  event_id     String   @id
  source       String
  processed_at DateTime @default(now())

  @@index([source, processed_at])
  @@map("processed_webhook_events")
}

// ============================================================================
// FORMS
// ============================================================================
// Unlike pages and slides, a form's DEFINITION lives in Postgres, not in the
// classroom's GitHub content repo: responses foreign-key to the exact revision
// they were filled against, and a Git-backed content.json cannot participate in
// that transaction. Definitions are immutable revisions, so editing a live form
// never orphans the answers already collected.

model Form {
  id                  String     @id @default(uuid())
  classroom_id        String
  title               String
  /// The form's address: `/{class}/forms/{slug}`. Derived from the title at
  /// create and immutable once the form is published — a slug already in
  /// circulation must not break. Reserved words (edit/responses/new) are
  /// rejected in form.service, not here.
  slug                String
  description         String?
  /// Frozen once status leaves DRAFT (enforced in form.service).
  access              FormAccess @default(PUBLIC)
  status              FormStatus @default(DRAFT)
  /// The builder's working copy of the field list, in the same shape a
  /// FormRevision stores. Revisions are immutable and are foreign-keyed by the
  /// responses filled against them, so an in-progress edit cannot live in one —
  /// it lives here until `publish` snapshots it into revision N+1.
  draft_fields        Json?
  /// The revision the fill page renders. Null until first publish. Deliberately
  /// a plain column and NOT a relation: a FK here plus FormRevision.form_id
  /// would be a cycle, and the pointer is only ever set to a revision of this
  /// same form (form.service is the only writer).
  current_revision_id String?
  /// Max VERIFIED responses. Null = uncapped. Enforced atomically under a row
  /// lock on this form, counting only submission_state SUBMITTED rows.
  response_cap        Int?
  closes_at           DateTime?
  /// A filler may replace their existing response until the form closes. The
  /// per-mode partial unique indexes hold either way: one row per identity,
  /// overwritten rather than duplicated.
  allow_multiple      Boolean    @default(false)
  /// Public fills always store a server-side row (they must, to be verified).
  /// This governs anonymous DRAFT autosave: off → localStorage only, on →
  /// drafts persist server-side keyed by draft_token, with an on-form
  /// disclosure. Kept indefinitely — nothing expires form responses.
  ///
  /// There is deliberately no cleanup job. A handful of half-started entries
  /// costs nothing, staff rather like seeing them, and a sweep is a scheduled
  /// task plus a retention constant plus tests to guard a problem nobody has.
  /// If volume ever becomes one, that is the moment to design for it.
  ///
  /// ON by default. Losing a half-filled form to a closed tab is the ordinary
  /// disaster, and localStorage does not survive a different device, a private
  /// window, or cleared site data. An instructor who would rather not hold
  /// partial answers can turn it off per form.
  save_partials       Boolean    @default(true)
  confirmation_email  Boolean    @default(false)
  created_by          String
  created_at          DateTime   @default(now())
  updated_at          DateTime   @default(now()) @updatedAt

  classroom    Classroom      @relation(fields: [classroom_id], references: [id], onDelete: Cascade)
  creator      User           @relation(fields: [created_by], references: [id])
  revisions    FormRevision[]
  responses    FormResponse[]
  module_items ModuleItem[]

  @@unique([classroom_id, slug])
  @@index([classroom_id])
  @@map("forms")
}

/// An immutable snapshot of a form's field list. Replaces per-response
/// definition snapshots: every response points at the revision it rendered
/// against, so one row holds the schema for all of them.
model FormRevision {
  id      String @id @default(uuid())
  form_id String
  version Int
  /// The versioned definition contract (see formContract.ts) — a field list,
  /// every field carrying a uuid `id` that answers key on. Tier-1 option
  /// sources (roster, teaching team) are MATERIALIZED to {id,label} here at
  /// publish; Tier-2 (teammates) resolve per respondent at render and are
  /// never stored in a revision.
  fields  Json

  created_at DateTime @default(now())

  form      Form           @relation(fields: [form_id], references: [id], onDelete: Cascade)
  responses FormResponse[]

  @@unique([form_id, version])
  @@map("form_revisions")
}

model FormResponse {
  id               String  @id @default(uuid())
  form_id          String
  /// What the person actually saw. Cascade rather than Prisma's default
  /// Restrict: deleting a form cascades to both revisions and responses, and
  /// under Restrict that delete order is a coin flip. No path ever deletes a
  /// revision on its own.
  revision_id      String
  /// Null for anonymous public submissions; the session user for classroom
  /// fills. SetNull so a deleted account leaves the response (and its
  /// resolved_context name snapshot) intact.
  user_id          String?
  /// As typed, for display. `email_normalized` (lower/trim) is the identity key
  /// the partial unique index enforces.
  email            String
  email_normalized String
  name             String?
  /// { [fieldUuid]: value }. Repeat groups nest exactly one level:
  /// { [groupUuid]: { [targetUserId]: { [fieldUuid]: value } } }.
  answers          Json
  /// Per-respondent Tier-2 snapshot: the resolved team, its scope, and the
  /// review targets [{ user_id, name, login, removed }]. Names are snapshotted
  /// so roster churn and account deletion never orphan a peer review — never
  /// re-joined against the live roster.
  resolved_context Json?

  submission_state SubmissionState @default(PENDING_VERIFICATION)
  /// Magic-link confirmation time. Set once and preserved across later edits —
  /// the cap and the FIFO ordering count from the FIRST verification.
  verified_at      DateTime?
  /// Opaque cookie value keying an anonymous server-side partial (only when the
  /// form's save_partials is on). Kept until somebody deletes it — there is no
  /// expiry sweep.
  draft_token      String?         @unique
  /// Staff-only free-text triage label ("responded to", "on roster", …).
  /// Suggestions come from the labels already used on the same form. Never
  /// visible to the filler on any surface, including the magic-link review page.
  staff_status     String?
  /// Staff-only note living with the submission. Same visibility rule.
  staff_note       String?

  submitted_at DateTime @default(now())
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt

  form     Form             @relation(fields: [form_id], references: [id], onDelete: Cascade)
  revision FormRevision     @relation(fields: [revision_id], references: [id], onDelete: Cascade)
  user     User?            @relation(fields: [user_id], references: [id], onDelete: SetNull)
  tokens   FormMagicToken[]

  // Identity uniqueness is per access mode and cannot be expressed in Prisma —
  // two PARTIAL unique indexes are added by raw SQL in the migration:
  //   (form_id, user_id)          WHERE user_id IS NOT NULL
  //   (form_id, email_normalized) WHERE user_id IS NULL
  @@index([form_id, submitted_at])
  @@map("form_responses")
}

/// Single-use, short-lived verify/edit links for public submissions. The raw
/// token is emailed and never stored; only its sha256 hex digest lives here.
/// `created_at` also drives the per-response send cooldown.
model FormMagicToken {
  id          String    @id @default(uuid())
  response_id String
  token_hash  String    @unique
  expires_at  DateTime
  used_at     DateTime?
  created_at  DateTime  @default(now())

  /// What the mail provider called the message this token was sent in.
  ///
  /// One token is one send, which is what makes this row the natural place to
  /// correlate a bounce back to a response: the provider's webhook knows only a
  /// message id, and without this it can say "something bounced" and nothing
  /// more. Nullable because it is written AFTER the send returns — the send is
  /// dispatched through Trigger.dev, so the id exists only inside that run —
  /// and because every send made before this column existed has none.
  provider_message_id String?
  /// How delivery went, as the provider last reported it: 'SENT', 'DELIVERED',
  /// 'BOUNCED', 'DELAYED', 'COMPLAINED'. A plain string rather than an enum
  /// because the set belongs to the provider, and an unfamiliar event type
  /// should become a value we ignore rather than a migration that blocks a
  /// webhook.
  delivery_state  String?
  /// The provider's stated reason, for the staff row. Never shown to a filler.
  delivery_detail String?

  response FormResponse @relation(fields: [response_id], references: [id], onDelete: Cascade)

  @@index([response_id])
  /// The webhook's only lookup key: a bounce arrives naming a message, and this
  /// is what turns that into a response. NOT unique — a provider retry carries
  /// the same id, and a duplicate must be a no-op rather than an error.
  @@index([provider_message_id])
  @@map("form_magic_tokens")
}

/// Path → git object map for a classroom's content repo, refreshed from push
/// webhooks and a TTL sweep. Read once per page render to turn a repo path
/// into a content-addressed, signed URL. Blob rows are files; tree rows are
/// directories (theme folders are served by their tree SHA).
model ContentAsset {
  classroom_id String
  path         String
  sha          String
  type         String // 'blob' | 'tree'
  size         Int      @default(0)
  synced_at    DateTime

  classroom Classroom @relation(fields: [classroom_id], references: [id], onDelete: Cascade)

  @@id([classroom_id, path])
  @@index([classroom_id, type])
  /// Reverse lookup: given the sha out of a signed URL, find a path that holds
  /// it. The editor does this on save so a stored block keeps the repo path
  /// rather than freezing a signed URL into the content. Any matching row will
  /// do — content-addressed means every path with this sha is byte-identical.
  @@index([classroom_id, sha])
  /// Freshness probe: `ensureContentAssets` reads the newest `synced_at` for a
  /// classroom on the render path. Without this it scans and sorts every row
  /// the classroom has, on every render.
  @@index([classroom_id, synced_at])
  @@map("content_assets")
}
