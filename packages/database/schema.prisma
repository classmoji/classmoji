model TokenTransaction {
  id                     String               @id @default(uuid())
  classroom_id           String
  student_id             String
  git_repo_assignment_id String?
  amount                 Int
  type                   TokenTransactionType
  hours_purchased        Int?
  balance_after          Int
  description            String               @default("")
  is_cancelled           Boolean              @default(false)
  created_at             DateTime             @default(now())
  updated_at             DateTime             @default(now()) @updatedAt

  classroom           Classroom          @relation(fields: [classroom_id], references: [id], onDelete: Cascade)
  student             User               @relation(fields: [student_id], references: [id], onDelete: Cascade)
  git_repo_assignment GitRepoAssignment? @relation(fields: [git_repo_assignment_id], references: [id], onDelete: Cascade)
