{
  "name": "@classmoji/database",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:reset": "prisma migrate reset --force",
    "db:reset:noseed": "prisma migrate reset --force --skip-seed",
    "db:seed": "node ./scripts/seed.js",
    "backfill:repo-analytics": "tsx scripts/backfillRepoAnalytics.ts",
    "db:console": "@prismatools/console@latest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\""
  },
  "exports": {
    ".": "./index.ts",
    "./gitIdentity": "./gitIdentity.ts",
    "./seed-fixtures": "./scripts/seed-fixtures.js",
    "./pg-adapter": "./pgAdapter.ts",
    "./worker-client": "./generated/worker/client.ts"
  },
  "dependencies": {
    "@classmoji/utils": "*",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "^6.6.0",
    "dayjs": "^1.11.13",
    "pg": "8.23.1"
  },
  "prisma": {
    "seed": "node ./scripts/seed.js"
  },
  "devDependencies": {
    "prisma": "^6.6.0",
    "vitest": "^4.1.5"
  }
}
