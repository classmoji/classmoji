{
  "name": "@classmoji/database",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "node --experimental-strip-types scripts/ensureGenerated.ts --force",
    "db:ensure": "node --experimental-strip-types scripts/ensureGenerated.ts",
    "db:reset": "prisma migrate reset --force && prisma db seed",
    "db:reset:noseed": "prisma migrate reset --force",
    "db:seed": "node ./scripts/seed.js",
    "backfill:repo-analytics": "tsx scripts/backfillRepoAnalytics.ts",
    "db:console": "@prismatools/console@latest"
  },
  "exports": {
    ".": "./index.ts",
    "./gitIdentity": "./gitIdentity.ts",
    "./seed-fixtures": "./scripts/seed-fixtures.js",
    "./pg-adapter": "./pgAdapter.ts",
    "./pg-client": "./pgClient.ts",
    "./client": {
      "browser": "./generated/node/browser.ts",
      "default": "./generated/node/client.ts"
    },
    "./worker-client": "./generated/worker/client.ts",
    "./wait-until": "./requestContext.ts",
    "./testing/prisma-errors": "./testing/prismaErrors.ts",
    "./testing/schema-dmmf": "./testing/schemaDmmf.ts"
  },
  "dependencies": {
    "@classmoji/utils": "*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dayjs": "^1.11.13",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@prisma/prisma-schema-wasm": "8.1.0-1.d1b3f377ca835d73fd50954a5e22128b9ebdd6b8",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "vitest": "^5.1.0"
  }
}
