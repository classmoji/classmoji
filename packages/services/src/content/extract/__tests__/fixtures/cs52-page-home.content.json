    {
      "id": "c5b35052-2e7d-400f-ae89-bad4f7992c66",
      "type": "heading",
      "props": {
        "backgroundColor": "blue",
        "textColor": "default",
        "textAlignment": "left",
        "level": 2,
        "isToggleable": false
      },
      "content": [
        {
          "type": "text",
          "text": "Course Overview",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "1bb29f3b-f888-49d2-8e30-98d051c8197f",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "The Web is a powerful delivery tool for complex real-time applications. This is a new hands-on course that will introduce the state of the art of full-stack web development. You will learn to build not only interactive web applications, but also chatbots, and mobile apps. This class will be an adventure and requires active participation both inside and outside of class. There will be lab projects, exercises in class, and a collaborative final project.",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "4f625f84-3279-4948-b423-81b1f80ecd1c",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "By the end of term, you will:",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "56c72d2c-637c-40be-b761-996f073b3c5d",
      "type": "bulletListItem",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "use your knowledge of the fundamental concepts and best practices of web application development to architect web systems from the ground up",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "8f7f3ebc-00a7-4725-abf7-ec60eea974c6",
      "type": "bulletListItem",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "work with and understand state of the art tools and frameworks used to build web technologies",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "1ba1dfb4-276b-4280-b356-8a79fc6e9f36",
      "type": "bulletListItem",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "design and build your own web applications with front-end UIs and server-side APIs",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "10df7604-8a70-4f94-841e-9e3a9c182ea4",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Topics include",
          "styles": {
            "bold": true
          }
        },
        {
          "type": "text",
          "text": ": static pages, Internet protocols, layout, markup, event-driven asynchronous programming, deployment, security, scalability, and user experience.",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "c46f06f2-caa6-48fc-b2a7-a27faf27b124",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Prerequisites",
          "styles": {
            "bold": true
          }
        },
        {
          "type": "text",
          "text": ": CS10 or permission of ",
          "styles": {}
        },
        {
          "type": "link",
          "href": "mailto:tim@cs.dartmouth.edu",
          "content": [
            {
              "type": "text",
              "text": "instructor",
              "styles": {}
            }
          ]
        }
      ],
      "children": []
    },
