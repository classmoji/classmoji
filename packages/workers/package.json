{
  "name": "@classmoji/workers",
  "private": true,
  "type": "module",
  "description": "Shared glue for running classmoji's React Router apps on Cloudflare Workers",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "exports": {
    "./vite": "./src/vite.ts",
    "./runtime": "./src/runtime.ts",
    "./context": "./src/context.ts",
    "./entry-server": {
      "workerd": "./src/entry-server.workerd.tsx",
      "default": "./src/entry-server.node.tsx"
    }
  },
  "dependencies": {
    "@classmoji/database": "*",
    "@classmoji/utils": "*"
  },
  "peerDependencies": {
    "@react-router/node": "^8.5.1",
    "isbot": "^5.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "vite": "^8.3.6"
  },
  "devDependencies": {
    "vitest": "^5.1.0"
  }
}
