{
  "name": "@classmoji/workers",
  "private": true,
  "type": "module",
  "description": "Shared glue for running classmoji's React Router apps on Cloudflare Workers",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\""
  },
  "exports": {
    "./vite": "./src/vite.ts",
    "./runtime": "./src/runtime.ts",
    "./entry-server": {
      "workerd": "./src/entry-server.workerd.tsx",
      "default": "./src/entry-server.node.tsx"
    }
  },
  "dependencies": {
    "@classmoji/database": "*"
  },
  "peerDependencies": {
    "@react-router/node": "^7.18.5",
    "isbot": "^4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.18.5",
    "vite": "^6.4.5"
  },
  "devDependencies": {
    "vitest": "^4.1.5"
  }
}
