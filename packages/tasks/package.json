{
  "name": "@classmoji/tasks",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "trigger:dev": "npx trigger.dev@4.6.3 dev",
    "trigger:login": "npx trigger.dev@4.6.3 login",
    "trigger:deploy": "npx trigger.dev@4.6.3 deploy --push",
    "trigger:deploy:staging": "npx trigger.dev@4.6.3 deploy --push --env staging",
    "trigger:logout": "npx trigger.dev@4.6.3 logout",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@classmoji/database": "*",
    "@classmoji/services": "*",
    "@infisical/sdk": "^5.0.2",
    "@trigger.dev/build": "4.6.3",
    "@trigger.dev/python": "4.6.3",
    "@trigger.dev/react-hooks": "^4.4.0",
    "@trigger.dev/sdk": "4.6.3",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^3.3.2",
    "resend": "^6.20.0",
    "simple-git": "^3.36.0"
  },
  "trigger.dev": {
    "endpointId": "classflow-ahnN"
  },
  "devDependencies": {
    "vitest": "^4.1.4"
  }
