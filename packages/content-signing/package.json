{
  "name": "@classmoji/content-signing",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && npm run typecheck:workers",
    "typecheck:workers": "tsc --noEmit -p tsconfig.workers.json",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\""
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "vitest": "^4.1.5"
  }
}
