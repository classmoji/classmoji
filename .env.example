# =============================================================================
# Core
# =============================================================================

WEBAPP_URL="http://localhost:3000"
SLIDES_URL="http://localhost:6500"
PAGES_URL="http://localhost:7100"

# -----------------------------------------------------------------------------
# Public course sites ({subdomain}.{SITE_BASE_DOMAIN}, served by apps/pages)
# -----------------------------------------------------------------------------

# Bare domain course sites hang off — no scheme, no port, lowercase.
#   production  classmoji.io          → https://cs52.classmoji.io
#   staging     staging.classmoji.io  → https://cs52.staging.classmoji.io
#   local       lvh.me                → http://cs52.lvh.me:7100
# lvh.me (and every subdomain of it) resolves to 127.0.0.1 publicly, so local
# development needs no /etc/hosts entry. UNSET disables the feature entirely:
# the pages host stops rewriting site requests and the webapp's /site-return
# refuses to redirect. That is the safe default — leave it unset until launch.
SITE_BASE_DOMAIN=""

# OVERRIDE ONLY — normally leave unset. The session-cookie domain is DERIVED
# from SITE_BASE_DOMAIN as ".{SITE_BASE_DOMAIN}", which is right in every real
# environment: the cookie's job is to span the webapp and the course-site
# subdomains, and those live under SITE_BASE_DOMAIN by definition. With neither
# var set, production still defaults to ".classmoji.io" and development stays
# host-only (localhost logins keep working). Heads-up: once SITE_BASE_DOMAIN is
# set locally, the derived cookie domain means you browse the app at
# app.lvh.me:3000, not localhost (a .lvh.me cookie is never sent to localhost).
# Set this only to decouple the two (leading dot required), e.g. a future where
# tenant sites move off the auth domain entirely.
COOKIE_DOMAIN=""

# Prefix for every auth cookie name ("classmoji.session_token" by default).
# Staging MUST set "classmoji-staging": with both environments scoped to
# subdomains of classmoji.io, identically-named cookies shadow each other and a
# staging session can silently displace a production one in the same browser.
COOKIE_PREFIX=""

# -----------------------------------------------------------------------------
# Custom domains for course sites (PRO)
# -----------------------------------------------------------------------------

# The Stripe price that grants PRO. Resolved SERVER-SIDE in the checkout action
# and asserted by the hook-station webhook before any subscription is recorded
# as PRO. UNSET fails closed on the webhook side — no price, no tier — which is
# deliberate: a deployment that forgot this must stop granting PRO, not grant it
# for every price that happens to arrive. Needed by apps/webapp and
# apps/hook-station.
STRIPE_PRO_PRICE_ID=""

# Fly certificate automation for instructor-owned hostnames.
#
# FLY_CERTS_API_TOKEN is deliberately NOT called FLY_API_TOKEN: flyctl reads
# that name itself, so a value there would silently re-authenticate every local
# `flyctl` command run in this repo. Scope it to the pages app.
#
# FLY_PAGES_APP has NO default and the service refuses to call Fly without it —
# staging and production share one fly.toml, so a missing value would otherwise
# mean a staging click writing a certificate onto the PRODUCTION app.
#   production  classmoji-pages
#   staging     classmoji-pages-staging
#
# Both unset (the local default) leaves certificate automation off: domains can
# still be claimed, and the admin UI falls back to manual DNS instructions.
#
# Delivered with `fly secrets set … --app <app>`. Infisical stays the system of
# record; it is not the runtime delivery mechanism for Fly apps.
FLY_CERTS_API_TOKEN=""
FLY_PAGES_APP=""

# Machines API base. Override only to point tests at a mock.
# FLY_API_HOSTNAME="https://api.machines.dev"

# MCP resource server (apps/mcp). MCP_PUBLIC_URL is the externally reachable
# origin advertised in the OAuth protected-resource metadata (RFC 9728) and in
# WWW-Authenticate challenges — must match how MCP clients reach the server.
# In production both are required (MCP_PUBLIC_URL is asserted at startup) and
# set as Fly secrets / fly.toml env, not from this file. The MCP server also
# needs DATABASE_URL, BETTER_AUTH_SECRET, WEBAPP_URL, and TRIGGER_SECRET_KEY
# at runtime (regrade/publish tools trigger Trigger.dev tasks).
MCP_PUBLIC_URL="http://localhost:8100"
MCP_PORT="8100"

# Reserved for future MCP audience validation (RFC 8707 resource indicators).
# Currently UNUSED by code — do not set in any deploy config.
# MCP_AUDIENCE=""

# Dev/test ONLY. Double-gates the webapp's /test-login route and the MCP
# server's POST /dev/mint-token endpoint (both also require
# NODE_ENV=development). NEVER set this in staging/production — CI
# (mcp-devmint-guard) fails if it appears in apps/mcp deploy config.
ENABLE_TEST_LOGIN="false"

DATABASE_URL="postgresql://classmoji:classmoji@localhost:5433/classmoji"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"

# =============================================================================
# GitHub Integration
# Set up via the wizard at localhost:3000/setup (requires SETUP_GITHUB_APP=true)
# =============================================================================

SETUP_GITHUB_APP="true"

GITHUB_APP_ID=""
GITHUB_APP_NAME=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_PRIVATE_KEY_BASE64=""

# Generate with: openssl rand -base64 32
GITHUB_WEBHOOK_SECRET="change-me-generate-with-openssl-rand-base64-32"

# Signs the per-classroom HMAC token embedded in the autograding workflow
# (.github/workflows/classroom.yml). The workflow reports results by triggering
# the `ingest_autograde_result` Trigger.dev task, which verifies this token.
# Generate with: openssl rand -hex 32. If unset, autograding still runs but
# results are not reported back to Classmoji.
AUTOGRADE_CALLBACK_SECRET="change-me-generate-with-openssl-rand-hex-32"

# Optional. Lifts the marketing site's build-time GitHub stars fetch from the
# 60/hour unauthenticated limit to 5,000/hour. CI (GitHub Actions) provides this
# automatically; only set it locally if repeated `site:build` runs hit a 403.
GITHUB_TOKEN=""

# =============================================================================
# Background Jobs / Trigger.dev
# Get your dev key at trigger.dev → API Keys → Development
# Needed by the webapp, hook-station, AND the MCP server (apps/mcp) at
# runtime — MCP regrade/publish tools trigger Trigger.dev tasks.
# =============================================================================

TRIGGER_SECRET_KEY=""

# Optional: override the Trigger.dev project id. Leave blank to use the
# shared staging/prod project. Set this if you are developing against your
# own Trigger.dev project.
TRIGGER_PROJECT_ID=""

# =============================================================================
# Email (optional)
# =============================================================================

# Transactional email is sent through Resend by the `send_email` Trigger.dev
# task. Without RESEND_API_KEY the task throws; the rest of the app is fine.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=""
# Sender address. The domain must be verified in Resend or sends fail with 403.
# Defaults to "Classmoji <hello@classmoji.io>" when unset.
EMAIL_FROM=""
# Where replies go. classmoji.io has receiving disabled, so point this at a
# mailbox someone actually reads or student replies are lost.
EMAIL_REPLY_TO=""

# =============================================================================
# Media / Cloudinary (optional)
# =============================================================================

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# =============================================================================
# Other
# =============================================================================

# Generate with: openssl rand -base64 32
CALENDAR_SECRET="change-me-generate-with-openssl-rand-base64-32"

# =============================================================================
# AI Features (optional)
# =============================================================================

AI_AGENT_URL="http://localhost:6000"

# Generate with: openssl rand -hex 32
AI_AGENT_SHARED_SECRET="change-me-generate-with-openssl-rand-hex-32"

LLM_PROVIDER="anthropic"
LLM_MODEL="claude-sonnet-4-5-20250929"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

EXPLORATION_MODE="trigger"
EXPLORATION_MODEL="claude-haiku-4-5-20251001"
