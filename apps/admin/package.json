{
  "name": "@classmoji/admin",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "admin:dev": "node --conditions=development --experimental-strip-types server.ts",
    "admin:dev:cf": "NODE_ENV=development BUILD_TARGET=cloudflare CLOUDFLARE_ENV=dev react-router build && wrangler dev -c build/server/wrangler.json --port ${PORT:-7500}",
    "admin:build": "react-router build",
    "admin:build:cf": "BUILD_TARGET=cloudflare react-router build",
    "admin:start": "NODE_ENV=production node --experimental-strip-types server.ts",
    "admin:deploy:staging": "BUILD_TARGET=cloudflare CLOUDFLARE_ENV=staging react-router build && wrangler deploy -c build/server/wrangler.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@classmoji/auth": "*",
    "@classmoji/database": "*",
    "@classmoji/services": "*",
    "@classmoji/ui-components": "*",
    "@classmoji/utils": "*",
    "@classmoji/workers": "*",
    "@fontsource-variable/mona-sans": "^5.2.8",
    "@react-router/express": "^8.5.1",
    "@react-router/node": "^8.5.1",
    "@sentry/cloudflare": "11.11.0",
    "@sentry/react-router": "11.11.0",
    "@tabler/icons-react": "^3.51.0",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "isbot": "^5.2.2",
    "morgan": "^1.12.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@react-router/dev": "^8.5.1",
    "@react-router/fs-routes": "^8.5.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.19.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "4.156.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
