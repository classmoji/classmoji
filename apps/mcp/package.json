{
  "name": "@classmoji/mcp",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "mcp:dev": "NODE_ENV=${NODE_ENV:-development} node --watch --experimental-strip-types src/index.ts",
    "mcp:start": "node --experimental-strip-types src/index.ts"
  },
  "dependencies": {
    "@classmoji/auth": "*",
    "@classmoji/collab": "*",
    "@classmoji/database": "*",
    "@classmoji/page-schema": "*",
    "@classmoji/services": "*",
    "@classmoji/tasks": "*",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@trigger.dev/sdk": "4.8.3",
    "fastify": "^5.12.8",
    "playwright-core": "^1.58.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "vitest": "^4.1.5"
  }
}
