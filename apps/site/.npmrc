# Same as the repo root: the site is built on its own (Dockerfile), so it
# needs the setting too. @tabler/icons-react 2.x lists React <=18 as a peer.
legacy-peer-deps=true

# The site's production image installs without a lockfile (apps/site/Dockerfile),
# so this date freezes its transitive versions: npm only picks versions
# published before it. When updating the site's dependencies, move the date on
# deliberately (after the newest pin's publish time) and re-test the build.
# The monorepo's root install ignores this file.
before=2026-11-06T15:00:00Z
