---
// Black-and-white structural diagram for the Fundamentals page: a GitHub
// organization > repository maps to a Classmoji classroom > repository, and
// assignments are Classmoji's own layer on top of the repository (a push
// submits; in issue mode an issue is opened in the repo). Pure outline drawing
// in `currentColor`, so it renders dark-on-light in light mode and
// light-on-dark in dark mode with a single asset and no extra dependency.
// No fills/gradients (flat B&W only).
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<figure class:list={['my-8 mx-auto max-w-2xl', className]}>
  <svg
    viewBox="0 0 720 300"
    width="100%"
    role="img"
    aria-labelledby="ghmap-title ghmap-desc"
    style="color: inherit; font-family: var(--sl-font, 'Mona Sans Variable', 'Mona Sans', sans-serif);"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
  >
    <title id="ghmap-title">How Classmoji maps to GitHub</title>
    <desc id="ghmap-desc">
      A GitHub organization maps to a Classmoji classroom. A GitHub repository
      maps to a Classmoji repository. Assignments submit through the repository:
      a push to the student repo is the submission, or in issue mode Classmoji
      opens a GitHub issue there and closing it submits.
    </desc>

    <!-- Column headers -->
    <text x="170" y="38" text-anchor="middle" fill="currentColor" stroke="none"
      font-size="12" letter-spacing="1.5" opacity="0.6">GITHUB</text>
    <text x="550" y="38" text-anchor="middle" fill="currentColor" stroke="none"
      font-size="12" letter-spacing="1.5" opacity="0.6">CLASSMOJI</text>

    <!-- Left stack: Organization > Repository > pushes (and an issue, in issue mode) -->
    <rect x="40" y="56" width="260" height="208" rx="10" />
    <text x="56" y="82" fill="currentColor" stroke="none" font-size="15" font-weight="600">Organization</text>
    <rect x="60" y="96" width="220" height="152" rx="8" />
    <text x="74" y="120" fill="currentColor" stroke="none" font-size="13" font-weight="500">Repository</text>
    <rect x="78" y="138" width="184" height="42" rx="6" />
    <text x="94" y="164" fill="currentColor" stroke="none" font-size="13">Push</text>
    <rect x="78" y="190" width="184" height="42" rx="6" stroke-dasharray="4 3" />
    <text x="94" y="216" fill="currentColor" stroke="none" font-size="13">Issue <tspan opacity="0.6" font-size="11">(issue mode only)</tspan></text>

    <!-- Arrow -->
    <line x1="320" y1="160" x2="394" y2="160" />
    <polygon points="404,160 392,153 392,167" fill="currentColor" stroke="none" />

    <!-- Right stack: Classroom > Repository > Assignment submissions -->
    <rect x="420" y="56" width="260" height="208" rx="10" />
    <text x="436" y="82" fill="currentColor" stroke="none" font-size="15" font-weight="600">Classroom</text>
    <rect x="440" y="96" width="220" height="152" rx="8" />
    <text x="454" y="120" fill="currentColor" stroke="none" font-size="13" font-weight="500">Repository</text>
    <rect x="458" y="138" width="184" height="42" rx="6" />
    <text x="474" y="164" fill="currentColor" stroke="none" font-size="13">Assignment <tspan opacity="0.6" font-size="11">· push</tspan></text>
    <rect x="458" y="190" width="184" height="42" rx="6" stroke-dasharray="4 3" />
    <text x="474" y="216" fill="currentColor" stroke="none" font-size="13">Assignment <tspan opacity="0.6" font-size="11">· issue</tspan></text>
  </svg>
</figure>
