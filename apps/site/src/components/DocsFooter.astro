---
// Starlight's docs footer (edit link, last updated, previous/next) followed by
// our own line with the GitHub, Privacy Policy and Terms of Service links.
// starlight-theme-black rendered that line from its `footerText` option until
// 0.7, which dropped the option.
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default />

<p class="docs-footer-text">
  🍎 Built by educators and students.{' '}
  <a href="https://github.com/classmoji/classmoji">Contribute on GitHub</a>{' · '}
  <a href="/privacy">Privacy Policy</a>{' · '}
  <a href="/terms">Terms of Service</a>
</p>

<style>
  .docs-footer-text {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--muted-foreground);
    font-size: 0.875rem;
    line-height: 1.25rem;
    text-wrap: balance;
  }

  .docs-footer-text a {
    color: inherit;
    font-weight: 500;
    text-decoration-line: underline;
    text-underline-offset: 4px;
  }
</style>
