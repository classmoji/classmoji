---
// Black-and-white nested diagram for the Grading page: how grades aggregate.
// Read inside-out — the emoji or score values graders give average into a
// submission grade (minus any late penalty), and each assignment's grade is
// weighted by the assignment's own percentage into the course grade, with
// extra-credit assignments added on top. No repository tier, no drop-lowest.
// Pure outline drawing in `currentColor` so it flips black/white with the theme.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<figure class:list={['my-8 mx-auto max-w-2xl', className]}>
  <svg
    viewBox="0 0 620 250"
    width="100%"
    role="img"
    aria-labelledby="gradecalc-title gradecalc-desc"
    style="color: inherit; font-family: var(--sl-font, 'Mona Sans Variable', 'Mona Sans', sans-serif);"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
  >
    <title id="gradecalc-title">How Classmoji grades aggregate</title>
    <desc id="gradecalc-desc">
      Emoji or score values average into an assignment grade, minus any late
      penalty. Assignment grades combine into the course grade using each
      assignment's weight, with extra credit added on top.
    </desc>

    <!-- Outer: Course grade -->
    <rect x="24" y="30" width="572" height="200" rx="12" />
    <text x="44" y="58" fill="currentColor" stroke="none" font-size="15" font-weight="600">Course grade</text>
    <text x="44" y="78" fill="currentColor" stroke="none" font-size="11" opacity="0.6">weighted mean of assignment grades · each assignment's weight is a % · extra credit added on top</text>

    <!-- Inner: Assignment grade -->
    <rect x="56" y="96" width="508" height="112" rx="10" />
    <text x="76" y="124" fill="currentColor" stroke="none" font-size="14" font-weight="600">Assignment grade</text>
    <text x="76" y="144" fill="currentColor" stroke="none" font-size="11" opacity="0.6">mean of the values given to the submission · late penalty subtracted</text>

    <!-- Emoji or score values (innermost) -->
    <text x="78" y="186" stroke="none" font-size="17">❤️ 👍 👀</text>
    <text x="164" y="184" fill="currentColor" stroke="none" font-size="11" opacity="0.6">emoji values</text>
    <text x="256" y="184" fill="currentColor" stroke="none" font-size="11" opacity="0.6">or</text>
    <text x="276" y="185" fill="currentColor" stroke="none" font-size="13" font-weight="600">85</text>
    <text x="300" y="184" fill="currentColor" stroke="none" font-size="11" opacity="0.6">score values (0–100)</text>
  </svg>
</figure>
