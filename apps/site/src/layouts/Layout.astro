---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Classmoji - an open source alternative to Github Classroom',
  description = 'An open source alternative to Github Classroom that teaches where the code lives. Spin up a Github repository for every assignment, with automated workflows, slides, and pages.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Fonts: Mona Sans (UI/body, via fontsource CDN) + Noto Sans (logo wordmark, Google) -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://cdn.jsdelivr.net/npm/@fontsource-variable/mona-sans@5.2.8/index.css"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@700;800&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <!-- Dark mode follows the OS setting, like the webapp: `.dark` on <html>
         turns on every `dark:` style. Inline and blocking so the page never
         flashes light first. -->
    <script is:inline>
      (() => {
        const query = window.matchMedia('(prefers-color-scheme: dark)');
        const apply = () => {
          document.documentElement.classList.toggle('dark', query.matches);
          document.documentElement.style.colorScheme = query.matches ? 'dark' : 'light';
        };
        apply();
        query.addEventListener('change', apply);
      })();
    </script>
  </head>
  <body class="bg-white text-gray-900 font-sans antialiased dark:bg-page-dark dark:text-inkd-0">
    <slot />
  </body>
</html>
