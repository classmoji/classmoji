{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Deliberately NOT the production name, and deliberately bindingless.
  // wrangler applies the top level when no --env is given, so if this said
  // "classmoji-content" a bare `npx wrangler deploy` would overwrite the
  // production script with a build that has no R2 bucket, no Images binding
  // and no vars — a 503 on content.classmoji.io from a one-word slip. Every
  // real deploy names its environment (`--env staging` / `--env production`);
  // a bare one lands here, on a throwaway Worker nothing routes to.
  "name": "classmoji-content-unconfigured",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  // Workers Caching sits in front of the Worker; the Cache-Control we emit
  // (no-store for draft, immutable otherwise) is what decides what it keeps.
  "cache": {
    "enabled": true
  },

  // Secrets are not declared here. CI pushes them with `wrangler secret bulk`
  // from Infisical `/content-worker` after each deploy:
  //
  //   CONTENT_SIGNING_SECRET           HMAC master key for signed URLs
  //   CONTENT_WORKER_SHARED_SECRET     bearer token for the token endpoint
  //   CONTENT_SIGNING_SECRET_PREVIOUS  optional, and only while rotating: the
  //     key the current one replaced. Verification falls back to it so URLs
  //     already in browsers and caches keep working across the change; nothing
  //     signs with it. Blanking it in Infisical does NOT remove it from the
  //     Worker — `wrangler secret bulk` only sets the keys it is handed — so a
  //     rotation ends with an explicit
  //     `npx wrangler secret delete CONTENT_SIGNING_SECRET_PREVIOUS --env <env>`.
  //     See "Rotating the signing secret" in README.md.
  "env": {
    "staging": {
      "name": "classmoji-content-staging",
      "routes": [
        {
          "pattern": "content-staging.classmoji.io",
          "custom_domain": true
        }
      ],
      "vars": {
        "CONTENT_TOKEN_ENDPOINT": "https://staging.classmoji.io/api/content/token",
        "ENVIRONMENT": "staging"
      },
      "r2_buckets": [
        {
          "binding": "CACHE",
          "bucket_name": "classmoji-content-cache-stg"
        }
      ],
      "images": {
        "binding": "IMAGES"
      },
      "observability": {
        "enabled": true
      },
      // No cross_version_cache on staging: a deploy should invalidate, so what
      // you just shipped is what you are looking at.
      "cache": {
        "enabled": true
      }
    },

    // Defined so the two environments stay in step. NOT deployed by CI — there
    // is no production workflow, and deploying this is a deliberate, manual act.
    "production": {
      "name": "classmoji-content",
      "routes": [
        {
          "pattern": "content.classmoji.io",
          "custom_domain": true
        }
      ],
      "vars": {
        "CONTENT_TOKEN_ENDPOINT": "https://app.classmoji.io/api/content/token",
        "ENVIRONMENT": "production"
      },
      "r2_buckets": [
        {
          "binding": "CACHE",
          "bucket_name": "classmoji-content-cache-prod"
        }
      ],
      "images": {
        "binding": "IMAGES"
      },
      "observability": {
        "enabled": true
      },
      // Content is immutable and content-addressed, so a warm cache should
      // survive a deploy.
      "cache": {
        "enabled": true,
        "cross_version_cache": true
      }
    }
  }
}
